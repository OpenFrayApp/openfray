{
  "name": "openfray-public-route-limiter",
  "main": "index.ts",
  "compatibility_date": "2026-09-10",
  "ratelimits": [
    {
      "name": "SHARE_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "IMAGE_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "REPORT_RATE_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "CSP_REPORT_RATE_LIMIT",
      "namespace_id": "1004",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
}
