/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://cdn.usefathom.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.usefathom.com; font-src 'self'; connect-src 'self' https://jhfjzzciubewzujafadj.supabase.co wss://jhfjzzciubewzujafadj.supabase.co https://cloudflareinsights.com https://cdn.usefathom.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; worker-src 'self'; media-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; report-uri /api/csp-reports

/s/*
  X-Robots-Tag: noindex, nofollow
/p/*
  X-Robots-Tag: noindex, nofollow

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/docs/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/console/assets/*
  Cache-Control: public, max-age=31536000, immutable

/console/compendium/*
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=604800
/og-image.png
  Cache-Control: public, max-age=604800
/brand/*
  Cache-Control: public, max-age=604800
